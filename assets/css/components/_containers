/* ===== CONTENEDORES ===== */

.container {
  max-width: var(--bp-desktop);
  margin: 0 auto;
  padding: 0 var(--spacing-md);
}

.container--narrow {
  max-width: var(--bp-tablet);
  margin: 0 auto;
  padding: 0 var(--spacing-md);
}

.container--wide {
  max-width: var(--bp-wide);
  margin: 0 auto;
  padding: 0 var(--spacing-md);
}

/* Contenedores específicos de sección, si son necesarios y tienen estilos únicos */
.productos-section-container,
.masajes-section-container,
.contacto-section-container,
.reservas-section-container {
  max-width: var(--bp-wide);
  margin: 0 auto;
  padding: 0 var(--spacing-md);
}

@media (max-width: 48em) {
  .container,
  .container--narrow,
  .container--wide,
  .productos-section-container,
  .masajes-section-container,
  .contacto-section-container,
  .reservas-section-container {
    padding: 0 var(--spacing-sm);
  }
}